MONGODB_URI=mongodb://localhost:27017/garage-asa
PORT=4000
# Placeholders: set the real values
CHINA_DEPOSIT_PERCENT=50
DELIVERY_FEE=0
# Firebase Admin (verifies staff sign-in tokens). Service account JSON on ONE line, or use GOOGLE_APPLICATION_CREDENTIALS=/path/key.json
FIREBASE_SERVICE_ACCOUNT=
# Browser origins allowed to call the API, comma separated. Production: your Vercel URL.
CORS_ORIGINS=http://localhost:5173
# Where customers pay and pick up (shown at checkout; placeholders are shown until set)
LUMICASH_NUMBER=
BANK_NAME=
BANK_ACCOUNT=
PICKUP_ADDRESS=
# Cloudinary (part photos). Cloudinary console > Dashboard. The API secret stays on the server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Customer messages (Twilio). NOTIFY_CHANNEL = sms or whatsapp; leave empty to send nothing.
NOTIFY_CHANNEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
DEFAULT_COUNTRY_CODE=257
NOTIFY_MAX_PER_PHONE_DAY=6
