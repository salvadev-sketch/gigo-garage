# Firebase web app settings (Firebase console > Project settings > Your apps). These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Leave empty for local dev. In production: the server URL, e.g. https://gigo-garage-api.onrender.com
VITE_API_URL=
